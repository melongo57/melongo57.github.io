# Copia este archivo a `.env` y rellena con los datos de tu proyecto de
# Supabase (Panel → Project Settings → API).
#
# La "anon public key" está pensada para ir embebida en el cliente: no es un
# secreto. La seguridad la da Row Level Security (ver supabase/schema.sql),
# no ocultar esta clave. Aun así, `.env` no se sube al repositorio.
#
# Sin estas dos variables, la app funciona exactamente igual mano a mano
# (todo en IndexedDB): la sincronización es opcional.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
